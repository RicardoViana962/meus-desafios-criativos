import { Link } from 'react-router-dom'
import { useSimulationHistory } from '../hooks/useSimulationHistory'

export function SimulationHistoryPage() {
  const { history, removeSimulation } =
    useSimulationHistory()

  return (
    <main className="mx-auto max-w-5xl px-6 py-10">
      <div className="mb-8">
        <h1 className="text-3xl font-bold">
          Histórico de simulações
        </h1>

        <p className="mt-2 text-gray-500">
          Consulte suas análises financeiras anteriores.
        </p>
      </div>

      {history.length === 0 ? (
        <div className="rounded-xl border p-8 text-center">
          <p className="text-gray-500">
            Você ainda não possui simulações salvas.
          </p>

          <Link
            to="/"
            className="mt-4 inline-block rounded-lg px-5 py-3"
          >
            Criar primeira simulação
          </Link>
        </div>
      ) : (
        <div className="grid gap-4">
          {history.map((simulation) => (
            <article
              key={simulation.id}
              className="rounded-xl border p-5"
            >
              <div className="flex items-start justify-between gap-4">
                <div>
                  <h2 className="text-lg font-semibold">
                    {simulation.data.goal}
                  </h2>

                  <p className="text-sm text-gray-500">
                    {formatDate(simulation.createdAt)}
                  </p>
                </div>

                <strong>
                  R$ {simulation.data.goalValue.toFixed(2)}
                </strong>
              </div>

              <p className="mt-4 line-clamp-2 text-gray-600">
                {simulation.result.diagnosis}
              </p>

              <div className="mt-5 flex gap-3">
                <Link
                  to={`/historico/${simulation.id}`}
                  className="rounded-lg border px-4 py-2"
                >
                  Ver análise
                </Link>

                <button
                  type="button"
                  onClick={() =>
                    removeSimulation(simulation.id)
                  }
                  className="rounded-lg border px-4 py-2"
                >
                  Excluir
                </button>
              </div>
            </article>
          ))}
        </div>
      )}
    </main>
  )
}

function formatDate(date: string) {
  return new Intl.DateTimeFormat('pt-BR', {
    dateStyle: 'medium',
    timeStyle: 'short',
  }).format(new Date(date))
}
